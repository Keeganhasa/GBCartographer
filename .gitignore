# Dependencies and build output (rebuilt with npm install / npm run build)
node_modules/
dist/
dist-electron/

# Per-machine: which GB Studio project the dev server opens, and the backups GB Cartographer keeps before writing
cartographer.local.json
backups/

# OS / editor clutter
.DS_Store
Thumbs.db
*.log

# Never commit a GB Studio project (except the app's own demo)
*.gbsproj
!demo/demo.gbsproj

# The dev server's painted copy of the demo project (the shipped one is demo/), and its Map Room layouts
demo-project/
maps/

# Design mockups and review screenshots (local only)
review/

# Private working files: the to-do list and plan, notes for Claude, the dev log, the internal spec,
# the author's per-tile coloring record, and Claude's launch config. They live only on the author's machines.
TODO.md
CLAUDE.md
PROGRESS.md
docs/SPEC.md
docs/demo-tile-palettes.json
.claude/

# Only palettes ship to GitHub (the author, 2026-10-10): no art of any kind until its authors have given their
# blessing, not even CC0 or our own generated art. These stay on the author's machines:
# the demo's art, the README's screenshots and GIFs, and the wireframe library's art.
demo/assets/**/*.png
docs/*.png
docs/*.gif
src/wireframes/tiles.ts
src/wireframes/sprites.ts
src/wireframes/scenes.ts
src/wireframes/library.ts
src/wireframes/library.test.ts
demo/Cartographer/
